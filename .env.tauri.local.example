# Template for .env.tauri.local — committed for reference; the real
# file with secrets is gitignored via the `*.local` rule.
#
# Tauri 2 reads these at `tauri build` time and runs codesign +
# notarytool + stapler automatically. Without them, you get an
# unsigned ad-hoc build that triggers "unidentified developer" /
# "damaged" warnings on other people's Macs.

# Apple ID email tied to the Apple Developer account.
APPLE_ID="you@example.com"

# App-specific password generated at https://appleid.apple.com →
# "Sign-In and Security" → "App-Specific Passwords". Format is
# "xxxx-xxxx-xxxx-xxxx". Regenerate if leaked.
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# 10-char Team ID, visible at https://developer.apple.com/account
# top right.
APPLE_TEAM_ID="XXXXXXXXXX"

# Tauri Updater signing key (Ed25519). Generate via:
#   bun run tauri signer generate --ci --write-keys ~/.tauri/shiori-updater.key
# The public key lives in tauri.conf.json (committed). The private
# key file path goes here; keep a backup somewhere safe.
# Loss is unrecoverable — existing installs reject updates signed
# by a new key.
TAURI_SIGNING_PRIVATE_KEY_PATH="$HOME/.tauri/shiori-updater.key"
# Set TAURI_SIGNING_PRIVATE_KEY_PASSWORD here if the key was generated
# with a password.
