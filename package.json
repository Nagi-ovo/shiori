{
  "name": "shiori",
  "private": true,
  "license": "MIT",
  "version": "26.9.27",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "shiori": "bun cli/src/main.ts",
    "cli:installer-demo": "SHIORI_INSTALLER_FORCE_ANIMATION=1 sh cli/installer/demo.sh",
    "cli:installer-assemble": "bun cli/installer/assemble.ts",
    "cli:build": "bun cli/build.ts --target current",
    "cli:pack": "bun cli/pack.ts",
    "cli:npm-publish": "npm publish ./cli/npm",
    "cli:manifest": "bun cli/manifest.ts --target current",
    "cli:smoke": "bun cli/smoke.ts",
    "build": "bun scripts/pdfium/build-wasm.ts > /dev/null && tsc -b && vite build",
    "lint": "eslint .",
    "test": "bun test --path-ignore-patterns 'src-tauri/target/**' --path-ignore-patterns 'crates/**' --path-ignore-patterns 'cli/test/core/**'",
    "test:core": "bun scripts/pdfium/fetch.ts > /dev/null && . \"$HOME/.cargo/env\" && for c in shiori-core shiori-core-node; do cargo fmt --manifest-path crates/$c/Cargo.toml --check && cargo clippy -q --manifest-path crates/$c/Cargo.toml --all-targets -- -D warnings || exit 1; done && cargo test -q --manifest-path crates/shiori-core/Cargo.toml && cargo build -q --release --manifest-path crates/shiori-core-node/Cargo.toml && bun test crates/shiori-core-node/test cli/test/core && cargo fmt --manifest-path crates/shiori-core-wasm/Cargo.toml --check && for c in shiori-core shiori-core-wasm; do cargo clippy -q --manifest-path crates/$c/Cargo.toml --target wasm32-unknown-unknown -- -D warnings || exit 1; done && bun scripts/pdfium/build-wasm.ts > /dev/null && bun test crates/shiori-core-wasm/test",
    "verify": "bun run build && bun run lint && bun run test && cd site && bun run build && bun run lint",
    "perf:tab-fixtures": "bun scripts/generate-tab-perf-fixtures.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@docx-editor.dev/core": "^2.21.1",
    "@docx-editor.dev/fonts": "^2.21.1",
    "@docx-editor.dev/react": "^2.21.1",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@noble/hashes": "^2.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dexie": "^4.4.2",
    "dompurify": "^3.4.13",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.4",
    "nanoid": "^5.1.16",
    "opentype.js": "2.0.0",
    "parse5": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.6.205",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "react-virtuoso": "^4.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter-tight": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^30.0.1",
    "subset-font": "^2.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
